# Токен бота от @BotFather (обязательно)
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ID администраторов через запятую
ADMIN_IDS=123456789

# Ключ шифрования текстов в БД. Смените на свой!
# ВНИМАНИЕ: если изменить ключ после накопления данных, старые сообщения
# расшифровать не получится.
DB_ENCRYPTION_KEY=SaveMod_AES256_Default_Secret_Key_2025_Secure!

# Путь к базе (по умолчанию bot_database.sqlite рядом с проектом)
# DATABASE_PATH=/opt/bot/bot_database.sqlite

# Лимиты, МБ
MAX_EXPORT_MB=48
MAX_SINGLE_MEDIA_MB=35
MAX_IMPORT_FILE_MB=200
MAX_IMPORTED_MEDIA_MB=100

# Необязательно: свои картинки баннеров вместо assets/banner_*.jpg
# BANNER_MAIN=/opt/bot/images/main.jpg
# BANNER_SETTINGS=/opt/bot/images/settings.jpg
# BANNER_SUBSCRIPTION=/opt/bot/images/subscription.jpg
# BANNER_ADMIN=/opt/bot/images/admin.jpg
