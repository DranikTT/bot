# Токен бота от @BotFather (обязательно)
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ID администраторов через запятую
ADMIN_IDS=123456789

# Ключ шифрования текстов в БД (AES-256-GCM, формат enc:v1:).
# ВНИМАНИЕ: после смены ключа старые записи не расшифруются.
# Значение по умолчанию совпадает с прежними версиями бота, поэтому
# существующую базу можно переиспользовать.
DB_ENCRYPTION_KEY=SaveMod_AES256_Default_Secret_Key_2025_Secure!

# Путь к базе SQLite. По умолчанию — js/bot_database.sqlite.
# DATABASE_PATH=/opt/bot/bot_database.sqlite

# Адрес Bot API. Менять только для локального сервера Bot API или тестов.
# API_SERVER=https://api.telegram.org

# Лимиты, МБ
MAX_EXPORT_MB=48
MAX_SINGLE_MEDIA_MB=35
MAX_IMPORT_FILE_MB=200
MAX_IMPORTED_MEDIA_MB=100

# Кастомные эмодзи в текстах и кнопках (on/off).
# Требуют Telegram Premium у владельца бота либо юзернейма, купленного
# на Fragment. Если бот их не заслужил, он сам перейдёт на обычные эмодзи —
# меню продолжит работать. Значение off принудительно отключает их.
CUSTOM_EMOJI=on

# Подробный лог (on/off)
VERBOSE=off

# Баннеры меню лежат в assets/:
#   mainmenu.jpg      — главное меню
#   settings.jpg      — настройки
#   subscription.jpg  — тарифы и премиум
#   adminmenu.jpg     — админ-панель
# Отсутствующий или битый файл не ломает бота: меню уйдёт текстом.
